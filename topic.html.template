{% import "partials/icons.html" as ui with context %}
<!doctype html>
<html lang="ru">
<head>
    {{ ui.topic_head(topic) }}
</head>
<body>

{{ ui.topic_header() }}

<!-- Первый экран -->
{{ ui.topic_hero(topic) }}

{% if topic.warning %}
<div class="container">
    <p class="topic-notice">{{ topic.warning }}</p>
</div>
{% endif %}

{% if topic.intro %}
{{ ui.topic_text_split(topic.intro) }}
{% endif %}

{% if topic.topics_block %}
<section class="section section-alt">
    <div class="container">
        <h2 class="section-title">{{ topic.topics_block.heading }}</h2>
        <div class="topic-card-grid">
            {% for item in topic.topics_block.cards %}
            {%- if item.url %}
            <a href="{{ item.url }}" class="topic-page-card topic-card--link">
                <div class="topic-card-row">
                    <span class="dot"></span>
                    <div>
                        <h3 class="topic-page-card-title">{{ item.title }}</h3>
                        {% if item.sub %}<p class="topic-page-card-sub">{{ item.sub }}</p>{% endif %}
                    </div>
                </div>
                <span class="topic-card-more">Подробнее &rarr;</span>
            </a>
            {%- else %}
            <div class="topic-page-card">
                <span class="dot"></span>
                <div>
                    <h3 class="topic-page-card-title">{{ item.title }}</h3>
                    {% if item.sub %}<p class="topic-page-card-sub">{{ item.sub }}</p>{% endif %}
                </div>
            </div>
            {%- endif %}
            {% endfor %}
        </div>
        {% if topic.topics_block.notes %}
        <p class="{% if topic.topics_block.note_style == 'box' %}topic-box topic-box--sage{% else %}disclaimer{% endif %}">{{ topic.topics_block.notes|join("<br>\n        ") }}</p>
        {% endif %}
    </div>
</section>
{% endif %}

{% if topic.steps %}
<section class="section">
    <div class="container">
        <h2 class="section-title">{{ topic.steps.heading }}</h2>
        <div class="topic-steps">
            {% for step in topic.steps.list %}
            <div class="topic-step">
                <span class="topic-step-num">{{ loop.index }}</span>
                <h3 class="topic-step-title">{{ step.title }}</h3>
                <p class="topic-step-text">{{ step.text }}</p>
                {%- if step.link_line %}
                <p class="topic-step-link">{{ step.link_line }}</p>
                {%- endif %}
            </div>
            {% endfor %}
        </div>
        {% if topic.steps.footnote_text %}
        <p class="topic-steps-footnote">
            {{ topic.steps.footnote_text }}
            {% if topic.steps.footnote_url %}<a href="{{ topic.steps.footnote_url }}" target="_blank" rel="noopener">&rarr;</a>{% endif %}
        </p>
        {% endif %}
    </div>
</section>
{% endif %}

{% if topic.expect %}
{{ ui.topic_text_split(topic.expect) }}
{% endif %}

{% if topic.medical_note %}
<section class="section section-alt">
    <div class="container">
        <div class="topic-caution">
            <h2 class="topic-caution-heading">{{ topic.medical_note.heading }}</h2>
            {% if topic.medical_note.intro %}<p>{{ topic.medical_note.intro }}</p>{% endif %}
            <ul class="topic-caution-list">
                {% for item in topic.medical_note.list %}
                <li>{{ item }}</li>
                {% endfor %}
            </ul>
            {% if topic.medical_note.extra %}<p>{{ topic.medical_note.extra }}</p>{% endif %}
            {% if topic.medical_note.crisis %}<p class="topic-caution-crisis">{{ topic.medical_note.crisis }}</p>{% endif %}
        </div>
    </div>
</section>
{% endif %}

{% if topic.video %}
<section class="section" id="video">
    <div class="container">
        <h2 class="section-title">Видео</h2>
        {{ ui.topic_video(topic.video) }}
    </div>
</section>
{% endif %}

{% if topic.faq %}
<section class="section">
    <div class="container">
        <h2 class="section-title">{{ topic.faq.heading }}</h2>
        <div class="topic-faq">
            {% for item in topic.faq.list %}
            <div class="topic-faq-item">
                <h3 class="topic-faq-question">{{ item.q }}</h3>
                <p class="topic-faq-answer">{{ item.a }}</p>
                {%- if item.more %}
                <p class="topic-faq-answer topic-faq-more">{{ item.more }}</p>
                {%- endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<!-- Записаться на консультацию -->
{{ ui.topic_zapis(topic.zapis) }}

{{ ui.topic_footer() }}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
        crossorigin="anonymous"></script>
</body>
</html>
