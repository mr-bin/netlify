{% import "partials/icons.html" as ui with context %}
<!doctype html>
<html lang="ru">
<head>
    {{ ui.topic_head(topic) }}
</head>
<body>

{{ ui.topic_header() }}

<!-- Первый экран -->
<header class="topic-hero article-hero">
    <div class="container">
        <div class="stati-column">
            <p class="topic-breadcrumbs"><a href="/">Главная</a> / Статьи</p>
            <h1 class="topic-hero-title">Статьи</h1>
            {% for p in topic.intro %}
            <p class="topic-hero-lead">{{ p }}</p>
            {% endfor %}
        </div>
    </div>
    {{ ui.hero_wave() }}
</header>

<!-- Группы статей: порядок групп — data/stati-hub.yaml, карточки собираются
     из data/video/ и data/stati/. -->
<main class="section stati-main">
    <div class="container">
        <div class="stati-column">
            {% for group in topic.sections %}
            <section class="stati-group">
                <h2 class="stati-group-title">{{ group.heading }}</h2>
                <div class="stati-grid">
                    {% for card in group.cards %}
                    <a href="/{{ card.slug }}/" class="stati-card topic-card--link">
                        {%- if card.video %}
                        <span class="stati-card-tag">Есть видео</span>
                        {%- endif %}
                        <h3 class="stati-card-title">{{ card.card_title }}</h3>
                        <p class="stati-card-text">{{ card.card_text }}</p>
                        <span class="topic-card-more">Читать&nbsp;&rarr;</span>
                    </a>
                    {% endfor %}
                </div>
            </section>
            {% endfor %}
        </div>
    </div>
</main>

<!-- Концовка: приглашение, оговорка, запись. id="zapis" — сюда ведёт
     кнопка «Записаться» в шапке. -->
<section class="section topic-section-lavender" id="zapis">
    <div class="container">
        <div class="stati-column article-end">
            {% if topic.cta %}<p>{{ topic.cta }}</p>{% endif %}
            <p class="topic-box topic-box--sage stati-note">Психотерапия не&nbsp;заменяет медицинское лечение и&nbsp;работает как дополнение к&nbsp;наблюдению&nbsp;у&nbsp;врача.</p>
            <a href="/#consultation" class="btn-cta">Записаться на&nbsp;консультацию</a>
        </div>
    </div>
</section>

{{ ui.topic_footer() }}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
        crossorigin="anonymous"></script>
</body>
</html>
