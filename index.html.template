{% import "partials/icons.html" as ui with context %}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="Екатерина Заикина — психолог. Поддержка в репродуктивных трудностях и на пути к родительству: планирование, бесплодие, ЭКО, беременность, потери, менопауза. Онлайн, на русском языке.">
    <link rel="icon" href="/favicon.ico?v={{ favicon_v }}" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v={{ favicon_v }}">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v={{ favicon_v }}">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v={{ favicon_v }}">
    <link rel="canonical" href="{{ site_url }}/">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:url" content="{{ site_url }}/">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="Поддержка в репродуктивных трудностях и на пути к родительству: планирование, бесплодие, ЭКО, беременность, потери, менопауза. Онлайн, на русском языке.">
    <meta property="og:image" content="{{ site_url }}/resources/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ site_url }}/">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="Поддержка в репродуктивных трудностях и на пути к родительству: планирование, бесплодие, ЭКО, беременность, потери, менопауза. Онлайн, на русском языке.">
    <meta name="twitter:image" content="{{ site_url }}/resources/og-image.jpg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,600;0,700;1,400;1,500&family=Golos+Text:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="styles.css">
</head>
<body>

{{ ui.top_bar() }}

<a id="top"></a>

<!-- Hero -->
<header class="hero-section">
    <div class="hero container">
        <div class="hero-photo-frame">
            <img class="hero-photo rounded-circle" src="/resources/profile.png" alt="Екатерина Заикина" width="168" height="168">
        </div>
        <h1 class="hero-name">Екатерина Заикина</h1>
        <p class="hero-role">Психолог</p>
        <p class="hero-tagline">Поддержка в&nbsp;репродуктивных трудностях и&nbsp;на&nbsp;пути к&nbsp;родительству: планирование, ЭКО, беременность, потери, менопауза. Онлайн, на&nbsp;русском языке.</p>
        <p class="hero-subline">Работаю индивидуально с&nbsp;женщинами и&nbsp;мужчинами</p>
        <div class="hero-stats">
            <span class="hero-stat">Веду частную практику <strong>с {{ stats.practice_since }}</strong></span>
            <span class="hero-stat">Провела более <strong>{{ stats.sessions }}</strong> клиентских сессий</span>
            <span class="hero-stat">Работала с более чем <strong>{{ stats.clients }}</strong> клиентами</span>
        </div>
        {{ ui.cta_reveal("hero-contacts") }}
    </div>
    <div class="wave" aria-hidden="true">
        <svg viewBox="0 0 1440 70" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,40 C220,90 380,0 620,36 C860,72 1000,10 1230,34 C1330,44 1400,40 1440,32 L1440,70 L0,70 Z" style="fill:var(--color-bg)"/>
        </svg>
    </div>
</header>

<!-- Topics -->
<section class="section" id="topics">
    <div class="container">
        <h2 class="section-title">С&nbsp;чем можно прийти:</h2>
        <div class="topic-grid">
            <div class="topic-card"><span class="dot"></span><span>Планирование и&nbsp;ожидание беременности (тревога, долгое ожидание)</span></div>
            <div class="topic-card"><span class="dot"></span><span>Бесплодие неясного генеза<span class="topic-card-sub">Когда обследования не&nbsp;находят причин: долгое ожидание, внутренние сомнения и&nbsp;страхи, отношения в&nbsp;паре</span></span></div>
            <div class="topic-card"><span class="dot"></span><span>ЭКО (подготовка, неудачная попытка)</span></div>
            <div class="topic-card"><span class="dot"></span><span>Беременность (страхи и&nbsp;тревога, образ себя как мамы, перемены в&nbsp;жизни и&nbsp;теле)</span></div>
            <div class="topic-card"><span class="dot"></span><span>Потери беременности<span class="topic-card-sub">Выкидыш, замершая и&nbsp;внематочная беременность, потеря на&nbsp;позднем сроке, прерывание по&nbsp;медицинским показаниям</span></span></div>
            <div class="topic-card"><span class="dot"></span><span>Диагнозы (эндометриоз, миома, СПКЯ) и&nbsp;жизнь с&nbsp;ними</span></div>
            <div class="topic-card"><span class="dot"></span><span>Менопауза</span></div>
            <div class="topic-card"><span class="dot"></span><span>Мужское бесплодие и&nbsp;переживания партнёра<span class="topic-card-sub">Диагноз, ЭКО, ожидание, потеря беременности</span></span></div>
        </div>
        <p class="disclaimer">Психотерапия не&nbsp;заменяет медицинское лечение и&nbsp;работает как дополнение к&nbsp;наблюдению у&nbsp;врача.</p>
    </div>
</section>

<!-- Benefits -->
<section class="section section-alt">
    <div class="container">
        <h2 class="section-title">В&nbsp;работе со мной вы можете получить:</h2>
        <div class="benefit-grid">
            <div class="benefit-card"><span class="dot"></span><span>Внутреннюю опору и&nbsp;навык снижать тревогу в&nbsp;период неопределённости и&nbsp;ожидания</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Возможность прожить чувства, о&nbsp;которых трудно говорить с&nbsp;близкими (горе, вину, зависть, злость)</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Понимание своих желаний и&nbsp;ценностей, в&nbsp;том числе в&nbsp;вопросе, как двигаться дальше</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Возможность бережно разобраться в&nbsp;своих страхах, сомнениях и&nbsp;готовности к&nbsp;родительству</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Принятие перемен в&nbsp;теле и&nbsp;в&nbsp;жизни после беременности и&nbsp;родов</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Ощущение себя не&nbsp;только «пациентом» и&nbsp;«диагнозом», а&nbsp;целым человеком</span></div>
        </div>
        <p class="disclaimer">А&nbsp;ещё я работаю с&nbsp;темами жизненных перемен и&nbsp;переезда в&nbsp;другую страну&nbsp;— <a href="#faq">подробнее в FAQ</a>.</p>
    </div>
</section>

<!-- Video -->
<section class="section section-alt" id="video">
    <div class="container">
        <h2 class="section-title">Видео</h2>
        <p class="section-lede">Знакомство и&nbsp;короткие видео о&nbsp;моей работе</p>
        <div class="video-section" id="videoSection">
            <div class="video-main" id="videoMain"></div>
            <div class="video-more" id="videoMoreWrap" hidden>
                <h3 class="video-more-title">Ещё видео</h3>
                <div class="video-list" id="videoList"></div>
                <button type="button" class="btn-video-more" id="videoShowMore" hidden>Показать ещё видео</button>
            </div>
        </div>
        <script type="application/json" id="videosData">{{ videos_json }}</script>
        <p class="text-center mt-3"><a href="https://youtube.com/@psy_ekaterina_zaikina">{{ ui.youtube() }} Все видео на YouTube канале</a></p>
    </div>
</section>

<!-- Materials -->
<section class="section" id="materials">
    <div class="container">
        <h2 class="section-title">Материалы</h2>
        <p class="section-lede">Листы для самостоятельной работы. Можно распечатать или заполнять с&nbsp;телефона</p>
        <div class="materials-list">
            {% for item in materials %}
            <div class="material-card">
                <span class="material-icon">{{ ui.document_icon() }}</span>
                <div class="material-text">
                    <p class="material-title">{{ item.title }}</p>
                    <p class="material-desc">{{ item.description }}</p>
                    <p class="material-format">{{ item.format }}</p>
                    <div class="material-actions">
                        <a class="btn-material" href="{{ item.url }}" target="_blank" rel="noopener">Скачать</a>
                        {% if item.video_url %}
                        <a class="btn-material btn-material-outline" href="{{ item.video_url }}" target="_blank" rel="noopener">Смотреть видео</a>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Consultation -->
<section class="section" id="consultation">
    <div class="container">
        <h2 class="section-title">Индивидуальная консультация</h2>
        <div class="price-card">
            <p class="text-soft mb-0">Сессия длится 60 минут, проводится онлайн (Google&nbsp;Meet)</p>
            <p class="price-amount">£{{ price["gbp"] }}</p>
            <p class="price-note">Стоимость одинакова для первой и для всех последующих сессий</p>
            <p><strong>Первая сессия</strong> представляет собой интервью-знакомство, где вы знакомитесь со мной, а я&nbsp;— с вами. Мы обсуждаем возможные пути решения вашего запроса и принимаем решение о возможной совместной работе.</p>
            <p>Перед первой встречей я пришлю информированное согласие: в нём описано, как устроена работа, что происходит с вашими данными и где границы конфиденциальности. Прочитать его можно заранее, вопросы можно задать до встречи.</p>
            <div class="callout">
                <strong>Правило о&nbsp;24 часах:</strong> ваше время в&nbsp;моём расписании закреплено только за&nbsp;вами. Если вы отменяете или переносите встречу больше чем за&nbsp;24 часа&nbsp;— перенос свободный. Если вы отменяете или переносите встречу менее чем за&nbsp;24 часа, я прошу оплатить сессию: освободившееся время я уже не&nbsp;смогу предложить другому человеку. Если случилось что-то непредвиденное (срочный визит к&nbsp;врачу, перенос процедуры), напишите мне, и&nbsp;мы вместе решим, как быть.
            </div>
        </div>
        <div class="text-center mt-4">
            {{ ui.cta_reveal("consultation-contacts") }}
        </div>
    </div>
</section>

<!-- Education -->
<section class="section section-alt" id="education">
    <div class="container">
        <h2 class="section-title">Образование</h2>
        <div class="edu-stats">
            <span class="hero-stat"><strong>{{ stats.education_hours }}+</strong>&nbsp;часов дополнительного профессионального образования</span>
            <span class="hero-stat"><strong>{{ stats.therapy_hours }}+</strong>&nbsp;часов личной терапии</span>
            <span class="hero-stat"><strong>{{ stats.supervision_hours }}+</strong>&nbsp;часов супервизий</span>
        </div>
        <ol class="edu-timeline" id="eduTimeline">
            {% for item in edu_timeline %}
            <li class="edu-timeline-item{% if loop.index > edu_timeline_visible %} edu-timeline-item--extra{% endif %}">
                <span class="edu-timeline-dot"></span>
                <span class="edu-timeline-year">{{ item.year }}</span>
                <span class="edu-timeline-text">{{ item.title }}</span>
                {% if item.meta %}
                <span class="text-soft" style="display:block;font-size:.85rem;margin-top:.15rem;">{{ item.meta }}</span>
                {% endif %}
                {% if item.note %}
                <span class="text-soft" style="display:block;font-size:.85rem;">{{ item.note }}</span>
                {% endif %}
            </li>
            {% endfor %}
        </ol>
        {% if edu_timeline|length > edu_timeline_visible %}
        <div class="text-center mb-4">
            <button class="bio-toggle" type="button" id="eduTimelineToggle" aria-expanded="false" aria-controls="eduTimeline" data-label-more="Показать всё обучение" data-label-less="Свернуть">
                Показать всё обучение
            </button>
        </div>
        {% endif %}
        <p class="video-more-title text-center" style="margin-top:2.25rem;">Членство и&nbsp;аккредитация</p>
        <ul class="edu-status-list">
            {% for m in edu_memberships %}
            <li>{{ ui.chevron() }}<span>{{ m.text }}</span></li>
            {% endfor %}
        </ul>

        <p class="video-more-title text-center">Публикации и&nbsp;выступления</p>
        <ol class="edu-timeline">
            <li class="edu-timeline-item">
                <span class="edu-timeline-dot"></span>
                <span class="edu-timeline-year">2020</span>
                <span class="edu-timeline-text">Возможности логотерапии при работе с&nbsp;горем</span>
                <span class="text-soft" style="display:block;font-size:.85rem;margin-top:.15rem;">Доклад · преконгресс IX Всемирного конгресса по&nbsp;психотерапии, секция логотерапии</span>
                <span class="text-soft" style="display:block;font-size:.85rem;">Статья · сборник «Психологические проблемы смысла жизни и&nbsp;акме»</span>
                <a href="https://cyberleninka.ru/article/n/vozmozhnosti-logoterapii-pri-rabote-s-gorem" target="_blank" rel="noopener" style="display:inline-block;margin-top:.3rem;">Читать на КиберЛенинке ↗</a>
            </li>
            <li class="edu-timeline-item">
                <span class="edu-timeline-dot"></span>
                <span class="edu-timeline-year">2023</span>
                <span class="edu-timeline-text">Анализ мультфильма «Энканто» с&nbsp;точки зрения транзактного анализа</span>
                <span class="text-soft" style="display:block;font-size:.85rem;margin-top:.15rem;">Доклад · онлайн-конференция ОППЛ, модальность «Транзактный анализ&nbsp;— Восточная версия»</span>
                <a href="https://youtu.be/tGAzXHKkWys" target="_blank" rel="noopener" style="display:inline-block;margin-top:.3rem;">Смотреть доклад ↗</a>
            </li>
            <li class="edu-timeline-item">
                <span class="edu-timeline-dot"></span>
                <span class="edu-timeline-year">2023</span>
                <span class="edu-timeline-text">Мультфильм «Я краснею» и&nbsp;подростковый период через призму транзактного анализа</span>
                <span class="text-soft" style="display:block;font-size:.85rem;margin-top:.15rem;">Доклад · Всемирный конгресс «Транзактный анализ&nbsp;— Восточная версия»</span>
                <a href="https://youtu.be/dEFJDTIAcw0" target="_blank" rel="noopener" style="display:inline-block;margin-top:.3rem;">Смотреть доклад ↗</a>
            </li>
            <li class="edu-timeline-item">
                <span class="edu-timeline-dot"></span>
                <span class="edu-timeline-year">2025</span>
                <span class="edu-timeline-text">Семейный сценарий Дома Guerlain через призму транзактного анализа</span>
                <span class="text-soft" style="display:block;font-size:.85rem;margin-top:.15rem;">Доклад · конференция ОППЛ, модальность «Транзактный анализ&nbsp;— Восточная версия»</span>
                <a href="https://youtu.be/V4e5ps5a244" target="_blank" rel="noopener" style="display:inline-block;margin-top:.3rem;">Смотреть доклад ↗</a>
            </li>
        </ol>

        <p class="video-more-title text-center" style="margin-top:2.25rem;margin-bottom:.2rem;">Дипломы и сертификаты</p>
        <p class="text-center text-soft mb-3" style="font-size:.9rem;">Нажмите, чтобы увеличить</p>
        <div class="doc-grid" id="eduDocGrid">
            {% for doc in edu_documents %}
            <a href="{{ doc.url_full }}" class="doc-thumb{% if loop.index > edu_documents_visible %} doc-thumb--extra{% endif %}" data-full="{{ doc.url_full }}" data-title="{{ doc.caption }}">
                <img src="{{ doc.url_thumb }}" alt="{{ doc.caption }}" loading="lazy">
            </a>
            {% endfor %}
        </div>
        {% if edu_documents|length > edu_documents_visible %}
        <div class="text-center mt-3">
            <button class="bio-toggle" type="button" id="eduDocsToggle" aria-expanded="false" aria-controls="eduDocGrid" data-label-more="Показать все документы" data-label-less="Свернуть">
                Показать все документы
            </button>
        </div>
        {% endif %}
    </div>
</section>

<!-- About -->
<section class="section" id="about">
    <div class="container text-center">
        <button class="bio-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#bioBody" aria-expanded="false" aria-controls="bioBody">
            + Подробнее обо мне
        </button>
        <div class="collapse bio-body text-start" id="bioBody">
            <p>Я недирективный терапевт&nbsp;— это значит, что свою задачу я вижу в&nbsp;том, чтобы создать условия&nbsp;— <strong>безопасное и&nbsp;доверительное пространство</strong>, в&nbsp;котором вы смогли бы <strong>открыть себя</strong>.</p>
            <p>Психология&nbsp;— моё второе образование. А&nbsp;по&nbsp;первому я&nbsp;— инженер-программист, и&nbsp;до&nbsp;декрета <strong>работала в&nbsp;IT</strong>. Затем какое-то время я была волонтёром в&nbsp;частной русской школе: сначала ассистентом, потом учителем.</p>
            <p>У&nbsp;меня двое детей. И&nbsp;я хорошо понимаю, что <strong>быть мамой</strong>&nbsp;— это работа, которая требует умения и&nbsp;выносливости. Глядя на&nbsp;своих детей и&nbsp;на&nbsp;детей в&nbsp;школе, я стала интересоваться детской психологией. Читала Петрановскую, Млодик. Тогда я и&nbsp;решила стать психологом&nbsp;— мне захотелось сделать это своей миссией. Часто мы передаём детям то, что не&nbsp;успели прожить сами, как «горячую картошку» из&nbsp;поколения в&nbsp;поколение. Когда человек находит время разобраться в&nbsp;себе, он может остановить эту передачу и&nbsp;принести в&nbsp;свою семью больше спокойствия и&nbsp;уверенности.</p>
            <p>Тема репродуктивной сферы мне близка как женщине и&nbsp;как маме. Я вижу, как важно не&nbsp;оставаться один на&nbsp;один с&nbsp;тревогой, ожиданием и&nbsp;потерями. Мне важно, чтобы было пространство, где можно не&nbsp;держаться и&nbsp;поделиться сомнениями и&nbsp;страхами. Поэтому я прошла обучение по&nbsp;репродуктивной психосоматике и&nbsp;хочу помогать в&nbsp;этом направлении.</p>
            <p>С&nbsp;2016 года я живу в&nbsp;Англии. И&nbsp;мне очень понятны переживания человека, который меняет страну, сталкивается со <strong>сменой окружения</strong>. Чувствует разочарование, тревогу: «Справлюсь я или нет? Правильным ли было это решение или стоило выбрать другую страну?» У&nbsp;человека происходит большая <strong>переоценка ценностей</strong>, заново приходится выстраивать свою личность&nbsp;— и&nbsp;я готова быть с&nbsp;вами в&nbsp;этом процессе. Я знаю, как непросто проходить через важные и&nbsp;уязвимые периоды жизни вдали от&nbsp;дома, в&nbsp;другой системе и&nbsp;на&nbsp;другом языке.</p>
            <p>Мне интересно, как устроены люди, я внимательно слушаю и&nbsp;бережно отношусь к&nbsp;опыту другого. Мне важно, что он думает, чего боится, как у&nbsp;него складывается жизнь. И&nbsp;как терапевту мне ценно увидеть то значимое, что порой скрыто за&nbsp;словами, и&nbsp;понять вас.</p>
            <p>Я верю, что у&nbsp;каждого есть <strong>внутренние ресурсы</strong>, даже если сейчас их трудно почувствовать. Моя задача не&nbsp;подсказывать, как вам жить, а&nbsp;быть рядом и&nbsp;помогать услышать себя: что вы чувствуете, чего хотите, какое решение для вас верное. Не&nbsp;всегда получается изменить обстоятельства, но можно изменить отношение к&nbsp;ним, вернуть опору и&nbsp;ощущение «я живу свою жизнь», а&nbsp;не&nbsp;«мной живут».</p>
            <p>Буду рада знакомству!</p>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="section" id="faq">
    <div class="container">
        <h2 class="section-title">FAQ</h2>
        <div class="faq-list narrow">
            {% set opyt_answer = "Я практикую с&nbsp;" ~ stats.practice_since ~ " года, провела более " ~ stats.sessions ~ " сессий. У&nbsp;меня есть опыт сопровождения женщин во время беременности: мы работали со страхами и&nbsp;тревогой, с&nbsp;образом себя как мамы, с&nbsp;переживаниями о&nbsp;переменах в&nbsp;жизни и&nbsp;теле после родов. В&nbsp;2026 году я прошла обучение по&nbsp;репродуктивной психосоматике (144 часа) и&nbsp;развиваю это направление, работая с&nbsp;супервизором." %}
            {% set faqs = [
                ("Нужно ли направление от&nbsp;врача?", "Нет, направление не&nbsp;нужно. Психотерапия не&nbsp;заменяет медицинское лечение и&nbsp;идёт параллельно с&nbsp;наблюдением у&nbsp;врача. Вопросы диагностики и&nbsp;лечения решаются с&nbsp;вашим врачом, я с&nbsp;ними не&nbsp;работаю."),
                ("Нужно ли что-то подписывать?", "Да, перед первой встречей я отправляю информированное согласие. Подписывать на&nbsp;бумаге не&nbsp;нужно: достаточно ответить на&nbsp;письмо, что вы прочитали документ и&nbsp;согласны. Если у&nbsp;вас есть вопросы по&nbsp;тексту, задайте их до&nbsp;встречи."),
                ("Кто узнает, что я обращаюсь к&nbsp;психологу?", "<p>Никто, если вы сами не&nbsp;захотите рассказать. Всё, что вы говорите на&nbsp;встречах, остаётся между нами: я не&nbsp;сообщаю третьим лицам ни содержание сессий, ни сам факт вашего обращения.</p><p>Я не&nbsp;записываю сессии ни на&nbsp;аудио, ни на&nbsp;видео и&nbsp;прошу вас тоже не&nbsp;записывать их без моего согласия.</p><p>Свою работу я обсуждаю с&nbsp;супервизором, как это принято в&nbsp;профессии, но только обезличенно, без имени и&nbsp;узнаваемых деталей. Есть несколько исключений, связанных с&nbsp;угрозой жизни и&nbsp;безопасности. Они подробно описаны в&nbsp;информированном согласии, которое я пришлю перед первой встречей.</p>"),
                ("Вы работаете с&nbsp;парами?", "Нет, я веду только индивидуальные консультации. Если вы хотите прийти вместе с&nbsp;партнёром, я могу подсказать, как найти специалиста по&nbsp;парной терапии."),
                ("Вы работаете с&nbsp;мужчинами?", "Да, индивидуально. Работаю с&nbsp;темой мужского бесплодия, а&nbsp;также с&nbsp;переживаниями, связанными с&nbsp;ЭКО или потерей беременности у&nbsp;партнёрши."),
                ("Работаете ли вы с&nbsp;другими запросами?", "Да, помимо репродуктивной сферы я работаю и&nbsp;с&nbsp;другими личными запросами, среди них:<ul class=\"faq-inline-list\"><li>Самооценка и&nbsp;уверенность в&nbsp;себе</li><li>Сложные перемены и&nbsp;жизненные ситуации</li><li>Работа с&nbsp;эмоциями</li><li>Отношения с&nbsp;партнёром, родителями, друзьями</li><li>Расставание, потеря близкого</li><li>Трудный прошлый опыт</li><li>Смысл жизни, жизненные цели, самоопределение</li><li>Прокрастинация и&nbsp;личная эффективность</li><li>Трудоголизм и&nbsp;баланс между работой и&nbsp;личной жизнью</li><li>Переезд и&nbsp;адаптация в&nbsp;другой стране</li></ul>Если у&nbsp;вас другой запрос&nbsp;— напишите, и&nbsp;мы обсудим, подхожу ли я вам."),
                ("Какой у&nbsp;вас опыт в&nbsp;репродуктивной теме?", opyt_answer),
                ("Сколько встреч потребуется?", "Это зависит от&nbsp;запроса. Кому-то хватает нескольких встреч, чтобы справиться с&nbsp;тревогой перед процедурой, а&nbsp;работа с&nbsp;потерей или длительным ожиданием может занять больше времени. Мы вместе оцениваем это после первой встречи и&nbsp;пересматриваем по&nbsp;ходу работы."),
                ("Как проходит первая сессия?", "Это знакомство. Вы рассказываете о&nbsp;своей ситуации, я рассказываю о&nbsp;том, как работаю, и&nbsp;мы решаем, подходим ли друг другу. Обязательств продолжать нет."),
                ("Могу ли я прийти, если всё ещё на&nbsp;этапе «просто думаю о&nbsp;беременности»?", "Да. Тревога, сомнения и&nbsp;усталость от&nbsp;ожидания&nbsp;— сами по&nbsp;себе повод."),
                ("Можно ли прийти после потери беременности, даже если прошло много времени?", "<p>Да. Неважно, на&nbsp;каком сроке случилась потеря и&nbsp;сколько времени прошло: месяц или несколько лет. Часто кажется, что раз время прошло, то уже не&nbsp;должно быть больно. Но работа горя&nbsp;— процесс длительный, и&nbsp;боль может возвращаться, например в&nbsp;дни, которые что-то значили.</p><p>В&nbsp;терапии есть пространство, где можно говорить о&nbsp;своём ребёнке так, как чувствуете вы, и&nbsp;бережно прожить то, что не&nbsp;удалось прожить тогда: грусть, злость, вину. Прийти можно и&nbsp;партнёру, если потеря по-своему затронула и&nbsp;его, даже когда об этом не&nbsp;принято говорить.</p>"),
                ("Работаете ли вы с&nbsp;психологической стороной бесплодия?", "<p>Да. Бывает, что обследования не&nbsp;находят причин, а&nbsp;беременность не&nbsp;наступает. Я не&nbsp;считаю, что всё сводится к&nbsp;психологии. Но мы можем бережно исследовать и&nbsp;психологическую сторону: внутренние конфликты, отношения в&nbsp;паре, готовность к&nbsp;материнству.</p><p>Например, женщина искренне хочет ребёнка и&nbsp;в&nbsp;то же время неосознанно боится, что его рождение изменит отношения с&nbsp;мужем, потому что когда-то, после её рождения, из&nbsp;семьи ушёл отец. Одно не&nbsp;отменяет другого. Но это лишь пример: у&nbsp;каждой и&nbsp;у&nbsp;каждого своя история, и&nbsp;что важно именно для вас, мы находим вместе.</p><p>Мы работаем и&nbsp;с&nbsp;тем, что часто сопровождает ожидание: с&nbsp;тревогой, виной, ощущением «я сама себе мешаю».</p><p>Терапия не&nbsp;гарантирует беременность, но помогает лучше понять себя и&nbsp;двигаться дальше с&nbsp;опорой на&nbsp;себя. Медицинские вопросы остаются за&nbsp;вашим врачом.</p>"),
                ("Гарантирует ли терапия беременность или улучшение состояния здоровья?", "Нет. Я не&nbsp;обещаю медицинских результатов. Терапия помогает справляться со стрессом, неопределённостью и&nbsp;эмоциями, и&nbsp;жить с&nbsp;большей опорой на&nbsp;себя."),
                ("Из&nbsp;каких стран вы принимаете?", "Из&nbsp;любой, консультации проходят онлайн. Я живу в&nbsp;Англии, время подбираем с&nbsp;учётом вашего часового пояса."),
                ("На&nbsp;каком языке проходят сессии?", "На&nbsp;русском."),
                ("Что, если мне нужна другая помощь?", "При острых состояниях (тяжёлая депрессия, мысли о&nbsp;самоповреждении) в&nbsp;первую очередь нужно обратиться к&nbsp;врачу или в&nbsp;кризисную службу. Я могу подсказать, куда обратиться, но сама такую помощь не&nbsp;оказываю."),
            ] %}
            {% for question, answer in faqs %}
            <details>
                <summary>{{ question }}</summary>
                <div class="faq-body">{{ answer }}</div>
            </details>
            {% endfor %}
        </div>
    </div>
</section>

