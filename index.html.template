{% import "partials/icons.html" as ui with context %}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="Екатерина Заикина — психолог. Поддержка в репродуктивных трудностях и на пути к родительству: планирование, ЭКО, беременность, потери, менопауза. Онлайн, на русском языке.">
    <link rel="icon" href="/favicon.ico?v={{ favicon_v }}" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v={{ favicon_v }}">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v={{ favicon_v }}">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v={{ favicon_v }}">
    <link rel="canonical" href="{{ site_url }}/">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="ru_RU">
    <meta property="og:url" content="{{ site_url }}/">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="Поддержка в репродуктивных трудностях и на пути к родительству: планирование, ЭКО, беременность, потери, менопауза. Онлайн, на русском языке.">
    <meta property="og:image" content="{{ site_url }}/resources/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="{{ site_url }}/">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="Поддержка в репродуктивных трудностях и на пути к родительству: планирование, ЭКО, беременность, потери, менопауза. Онлайн, на русском языке.">
    <meta name="twitter:image" content="{{ site_url }}/resources/og-image.jpg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,600;0,700;1,400;1,500&family=Golos+Text:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="styles.css">
</head>
<body>

{{ ui.top_bar() }}

<a id="top"></a>

<!-- Hero -->
<header class="hero-section">
    <div class="hero container">
        <div class="hero-photo-frame">
            <img class="hero-photo rounded-circle" src="/resources/profile.png" alt="Екатерина Заикина" width="168" height="168">
        </div>
        <h1 class="hero-name">Екатерина Заикина</h1>
        <p class="hero-role">Психолог</p>
        <p class="hero-tagline">Поддержка в репродуктивных трудностях и на пути к родительству: планирование, ЭКО, беременность, потери, менопауза. Онлайн, на русском языке.</p>
        <p class="hero-subline">Работаю индивидуально с женщинами и мужчинами</p>
        <div class="hero-stats">
            <span class="hero-stat">Веду частную практику <strong>с {{ stats.practice_since }}</strong></span>
            <span class="hero-stat">Провела более <strong>{{ stats.sessions }}</strong> клиентских сессий</span>
            <span class="hero-stat">Работала с более чем <strong>{{ stats.clients }}</strong> клиентами</span>
        </div>
        {{ ui.cta_reveal("hero-contacts") }}
    </div>
    <div class="wave" aria-hidden="true">
        <svg viewBox="0 0 1440 70" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0,40 C220,90 380,0 620,36 C860,72 1000,10 1230,34 C1330,44 1400,40 1440,32 L1440,70 L0,70 Z" style="fill:var(--color-bg)"/>
        </svg>
    </div>
</header>

<!-- Topics -->
<section class="section" id="topics">
    <div class="container">
        <h2 class="section-title">Я могу помочь в&nbsp;репродуктивной сфере в&nbsp;таких темах, как:</h2>
        <div class="topic-grid">
            <div class="topic-card"><span class="dot"></span><span>Планирование и&nbsp;ожидание беременности (тревога, долгое ожидание)</span></div>
            <div class="topic-card"><span class="dot"></span><span>ЭКО (подготовка, неудачная попытка)</span></div>
            <div class="topic-card"><span class="dot"></span><span>Беременность (страхи и&nbsp;тревога, образ себя как мамы, перемены в&nbsp;жизни и&nbsp;теле)</span></div>
            <div class="topic-card"><span class="dot"></span><span>Потери (замершая беременность, выкидыш, внематочная беременность)</span></div>
            <div class="topic-card"><span class="dot"></span><span>Диагнозы (эндометриоз, миома, СПКЯ) и&nbsp;жизнь с&nbsp;ними</span></div>
            <div class="topic-card"><span class="dot"></span><span>Менопауза</span></div>
            <div class="topic-card" style="grid-column: 1 / -1;"><span class="dot"></span><span>Мужское бесплодие и&nbsp;переживания партнёра<span class="topic-card-sub">Диагноз, ЭКО, ожидание, потеря беременности</span></span></div>
        </div>
        <p class="disclaimer">Психотерапия не&nbsp;заменяет медицинское лечение и&nbsp;работает как дополнение к&nbsp;наблюдению у&nbsp;врача.</p>
    </div>
</section>

<!-- Benefits -->
<section class="section section-alt">
    <div class="container">
        <h2 class="section-title">В&nbsp;работе со мной вы можете получить:</h2>
        <div class="benefit-grid">
            <div class="benefit-card"><span class="dot"></span><span>Внутреннюю опору в&nbsp;период неопределённости и&nbsp;ожидания</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Навык снижать тревогу и&nbsp;возвращаться в&nbsp;устойчивое состояние</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Возможность прожить чувства, о&nbsp;которых трудно говорить с&nbsp;близкими (горе, вину, зависть, злость)</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Понимание своих желаний и&nbsp;ценностей, в&nbsp;том числе в&nbsp;вопросе, как двигаться дальше</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Принятие перемен в&nbsp;теле и&nbsp;в&nbsp;жизни после беременности и&nbsp;родов</span></div>
            <div class="benefit-card"><span class="dot"></span><span>Ощущение себя не&nbsp;только «пациентом» и&nbsp;«диагнозом», а&nbsp;целым человеком</span></div>
            <div class="benefit-card" style="grid-column: 1 / -1;"><span class="dot"></span><span>Безопасное и&nbsp;доверительное пространство, где можно не&nbsp;держаться</span></div>
        </div>
        <p class="disclaimer">А&nbsp;ещё я работаю с&nbsp;темами жизненных перемен и&nbsp;переезда в&nbsp;другую страну — <a href="#faq">подробнее в FAQ</a>.</p>
    </div>
</section>

<!-- Video -->
<section class="section section-alt">
    <div class="container text-center">
        <div class="video-frame">
            <iframe src="https://www.youtube-nocookie.com/embed/I1egM49AIOM"
                    title="Видео от Екатерины Заикиной" frameborder="0"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe>
        </div>
        <p class="mt-3"><a href="https://youtube.com/@psy_ekaterina_zaikina">{{ ui.youtube() }} YouTube канал</a></p>
    </div>
</section>

<!-- Consultation -->
<section class="section" id="consultation">
    <div class="container">
        <h2 class="section-title">Индивидуальная консультация</h2>
        <div class="price-card">
            <p class="text-soft mb-0">Сессия длится 60 минут, проводится онлайн (Google&nbsp;Meet)</p>
            <p class="price-amount">£{{ price["gbp"] }} <small>GBP</small></p>
            <p class="price-note">Стоимость одинакова для первой и для всех последующих сессий</p>
            <p><strong>Первая сессия</strong> представляет собой интервью-знакомство, где вы знакомитесь со мной, а я — с вами. Мы обсуждаем возможные пути решения вашего запроса и принимаем решение о возможной совместной работе.</p>
            <p>Перед первой встречей я пришлю информированное согласие: в нём описано, как устроена работа, что происходит с вашими данными и где границы конфиденциальности. Прочитать его можно заранее, вопросы можно задать до встречи.</p>
            <div class="callout">
                <strong>Правило о 24 часах:</strong> ваше время в моём расписании закреплено только за вами. Если вы отменяете или переносите встречу больше чем за 24 часа — перенос свободный. Если вы отменяете или переносите встречу менее чем за 24 часа, я прошу оплатить сессию: освободившееся время я уже не смогу предложить другому человеку. Если случилось что-то непредвиденное (срочный визит к врачу, перенос процедуры), напишите мне, и мы вместе решим, как быть.
            </div>
        </div>
        <div class="text-center mt-4">
            {{ ui.cta_reveal("consultation-contacts") }}
        </div>
    </div>
</section>

<!-- Education -->
<section class="section section-alt" id="education">
    <div class="container">
        <h2 class="section-title">Образование</h2>
        <div class="edu-stats">
            <span class="hero-stat"><strong>{{ stats.education_hours }}+</strong>&nbsp;часов дополнительного профессионального образования</span>
            <span class="hero-stat"><strong>{{ stats.therapy_hours }}+</strong>&nbsp;часов личной терапии</span>
            <span class="hero-stat"><strong>{{ stats.supervision_hours }}+</strong>&nbsp;часов супервизий</span>
        </div>
        <ol class="edu-timeline">
            {% set timeline = [
                ("2019", "Повышение квалификации «Логотерапия и экзистенциальный анализ», 240 ч"),
                ("2020", "Профессиональная переподготовка «Логотерапия и экзистенциальный анализ», 384 ч"),
                ("2021", "Высшее психологическое образование, бакалавриат, Московский институт психоанализа"),
                ("2021–2023", "Повышение квалификации «Транзактный анализ — Восточная версия», 144 ч"),
                ("2022", "«Терапия идентичности», работа с психотравмой, 48 ч"),
                ("2022", "Повышение квалификации «Работа психолога с депрессивными состояниями», 72 ч"),
                ("2023–2024", "Повышение квалификации «Эриксоновская терапия и эриксоновский гипноз», 164 ч"),
                ("2026", "Повышение квалификации «Репродуктивная психосоматика» (И.В. Агеева), 144 ч"),
            ] %}
            {% for year, text in timeline %}
            <li class="edu-timeline-item">
                <span class="edu-timeline-dot"></span>
                <span class="edu-timeline-year">{{ year }}</span>
                <span class="edu-timeline-text">{{ text }}</span>
            </li>
            {% endfor %}
        </ol>
        <ul class="edu-status-list">
            <li>{{ ui.chevron() }}<span>Действительный член Общероссийской Профессиональной Психотерапевтической Лиги</span></li>
            <li>{{ ui.chevron() }}<span>Аккредитованный полимодальный психотерапевт (СРО «Союз психологов и психотерапевтов»)</span></li>
            <li>{{ ui.chevron() }}<span>Аккредитованный психотерапевт «Транзактный анализ — Восточная версия» (СРО «Союз психологов и психотерапевтов»)</span></li>
        </ul>

        <p class="text-center text-soft mb-3" style="font-size:.9rem;">Дипломы и сертификаты — нажмите, чтобы увеличить</p>
        <div class="doc-grid">
            {% set docs = [
                ("diplom-bakalavra", "Диплом бакалавра психологии, 2021"),
                ("logoterapiya-diplom-perepodgotovka", "Диплом о проф. переподготовке «Логотерапия и экзистенциальный анализ», 2020"),
                ("logoterapiya-udostoverenie", "Удостоверение «Логотерапия и экзистенциальный анализ», 2019"),
                ("logoterapiya-frankl-sertifikat", "Сертификат Института Виктора Франкла (Австрия), 2018–2020"),
                ("klinicheskaya-psihologiya-sertifikat", "Сертификат «Клиническая психология для логотерапевтов», 2021"),
                ("terapiya-identichnosti-udostoverenie", "Удостоверение «Терапия идентичности». Авторский метод работы с психотравмой, 2022"),
                ("depressivnye-sostoyaniya-udostoverenie", "Удостоверение «Работа психолога с депрессивными состояниями», 2022"),
                ("tranzaktnyy-analiz-udostoverenie", "Удостоверение «Транзактный анализ — Восточная версия», 2022"),
                ("tavv-prodvinutyy-udostoverenie", "Удостоверение «Транзактный анализ — Восточная версия», продвинутый курс, 2023"),
                ("eriksonovskaya-terapiya-udostoverenie", "Удостоверение «Эриксоновская терапия и эриксоновский гипноз», 2024"),
            ] %}
            {% for slug, caption in docs %}
            <a href="/resources/education/{{ slug }}.jpg" class="doc-thumb" data-full="/resources/education/{{ slug }}.jpg" data-title="{{ caption }}">
                <img src="/resources/education/thumbs/{{ slug }}.jpg" alt="{{ caption }}" loading="lazy">
            </a>
            {% endfor %}
        </div>
    </div>
</section>

<!-- About -->
<section class="section" id="about">
    <div class="container text-center">
        <button class="bio-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#bioBody" aria-expanded="false" aria-controls="bioBody">
            + Подробнее обо мне
        </button>
        <div class="collapse bio-body text-start" id="bioBody">
            <p>Я недирективный терапевт — это значит, что свою задачу я вижу в том, чтобы создать условия — <strong>безопасное и доверительное пространство</strong>, в котором вы смогли бы <strong>открыть себя</strong>.</p>
            <p>Психология — моё второе образование. А по первому я — инженер-программист, и до декрета <strong>работала в IT</strong>. Затем какое-то время я на общественных началах была учителем в частной русской школе.</p>
            <p>У меня двое детей. И я хорошо понимаю, что <strong>быть мамой</strong> — это работа, которая требует умения и выносливости. Глядя на своих детей и на детей в школе, я стала интересоваться детской психологией. Читала Петрановскую, Млодик. Тогда я и решила стать психологом — мне захотелось сделать это своей миссией. Исцеляя себя, человек несёт в свою семью и в мир уверенность, спокойствие и благополучие — и делает вклад в будущие поколения.</p>
            <p>Тема репродуктивной сферы мне близка как женщине и как маме. Я вижу, как важно не оставаться один на один с тревогой, ожиданием и потерями. Мне важно, чтобы было пространство, где можно поделиться сомнениями и страхами. Поэтому я прошла обучение по репродуктивной психосоматике и хочу помогать в этом направлении.</p>
            <p>С 2016 года я живу в Англии. И мне очень понятны переживания человека, который меняет страну, сталкивается со <strong>сменой окружения</strong>. Чувствует разочарование, тревогу: «Справлюсь я или нет? Правильным ли было это решение или стоило выбрать другую страну?» У человека происходит большая <strong>переоценка ценностей</strong>, заново приходится выстраивать свою личность — и я готова быть с вами в этом процессе. Я знаю, как непросто проходить через важные и уязвимые периоды жизни вдали от дома, в другой системе и на другом языке.</p>
            <p>Мне интересно, как устроены люди, я внимательно слушаю и бережно отношусь к опыту другого. Мне важно, что он думает, чего боится, как у него складывается жизнь. И как терапевту мне ценно увидеть то значимое, что порой скрыто за словами, и понять вас.</p>
            <p>Я верю, что у каждого есть <strong>внутренние ресурсы</strong>, даже если сейчас их трудно почувствовать. Моя задача не подсказывать, как вам жить, а быть рядом и помогать услышать себя: что вы чувствуете, чего хотите, какое решение для вас верное. Не всегда получается изменить обстоятельства, но можно изменить отношение к ним, вернуть опору и ощущение «я живу свою жизнь», а не «мной живут».</p>
            <p>Буду рада знакомству!</p>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="section" id="faq">
    <div class="container">
        <h2 class="section-title">FAQ</h2>
        <div class="faq-list narrow">
            {% set opyt_answer = "Я практикую с " ~ stats.practice_since ~ " года, провела более " ~ stats.sessions ~ " сессий. У меня есть опыт сопровождения женщин во время беременности: мы работали со страхами и тревогой, с образом себя как мамы, с переживаниями о переменах в жизни и теле после родов. В 2026 году я прошла обучение по репродуктивной психосоматике (144 часа) и развиваю это направление, работая с супервизором." %}
            {% set faqs = [
                ("Нужно ли направление от&nbsp;врача?", "Нет, направление не нужно. Психотерапия не заменяет медицинское лечение и идёт параллельно с наблюдением у врача. Вопросы диагностики и лечения решаются с вашим врачом, я с ними не работаю."),
                ("Нужно ли что-то подписывать?", "Да, перед первой встречей я отправляю информированное согласие. Подписывать на бумаге не нужно: достаточно ответить на письмо, что вы прочитали документ и согласны. Если у вас есть вопросы по тексту, задайте их до встречи."),
                ("Вы работаете с&nbsp;парами?", "Нет, я веду только индивидуальные консультации. Если вы хотите прийти вместе с партнёром, я могу подсказать, как найти специалиста по парной терапии."),
                ("Вы работаете с&nbsp;мужчинами?", "Да, индивидуально. Работаю с темой мужского бесплодия, а также с переживаниями, связанными с ЭКО или потерей беременности у партнёрши."),
                ("Работаете ли вы с&nbsp;другими запросами?", "Да, помимо репродуктивной сферы я работаю и с другими личными запросами, среди них:<ul class=\"faq-inline-list\"><li>Самооценка и уверенность в себе</li><li>Сложные перемены и жизненные ситуации</li><li>Работа с эмоциями</li><li>Отношения с партнёром, родителями, друзьями</li><li>Расставание, потеря близкого</li><li>Трудный прошлый опыт</li><li>Смысл жизни, жизненные цели, самоопределение</li><li>Прокрастинация и личная эффективность</li><li>Трудоголизм и баланс между работой и личной жизнью</li><li>Переезд и адаптация в другой стране</li></ul>Если у вас другой запрос — напишите, и мы обсудим, подхожу ли я вам."),
                ("Какой у&nbsp;вас опыт в&nbsp;репродуктивной теме?", opyt_answer),
                ("Сколько встреч потребуется?", "Это зависит от запроса. Кому-то хватает нескольких встреч, чтобы справиться с тревогой перед процедурой, а работа с потерей или длительным ожиданием может занять больше времени. Мы вместе оцениваем это после первой встречи и пересматриваем по ходу работы."),
                ("Как проходит первая сессия?", "Это знакомство. Вы рассказываете о своей ситуации, я рассказываю о том, как работаю, и мы решаем, подходим ли друг другу. Обязательств продолжать нет."),
                ("Могу ли я прийти, если всё ещё на&nbsp;этапе «просто думаю о&nbsp;беременности»?", "Да. Тревога, сомнения и усталость от ожидания — сами по себе повод."),
                ("Гарантирует ли терапия беременность или улучшение состояния здоровья?", "Нет. Я не обещаю медицинских результатов. Терапия помогает справляться со стрессом, неопределённостью и эмоциями, и жить с большей опорой на себя."),
                ("Из&nbsp;каких стран вы принимаете?", "Из любой, консультации проходят онлайн. Я живу в Англии, время подбираем с учётом вашего часового пояса."),
                ("На&nbsp;каком языке проходят сессии?", "На русском."),
                ("Что, если мне нужна другая помощь?", "При острых состояниях (тяжёлая депрессия, мысли о самоповреждении) в первую очередь нужно обратиться к врачу или в кризисную службу. Я могу подсказать, куда обратиться, но сама такую помощь не оказываю."),
            ] %}
            {% for question, answer in faqs %}
            <details>
                <summary>{{ question }}</summary>
                <div class="faq-body">{{ answer }}</div>
            </details>
            {% endfor %}
        </div>
    </div>
</section>

